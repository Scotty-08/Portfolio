ry" /></mxCell><mxCell id="notify" value="Notifications&#10;&#10;Enable, or skip for now" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8dde6;fontColor=#17202a;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="510" y="1070" width="260" height="110" as="geometry" /></mxCell><mxCell id="group" value="Lock Your First Group&#10;&#10;Choose apps and rules, or skip" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8dde6;fontColor=#17202a;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="1250" width="260" height="110" as="geometry" /></mxCell><mxCell id="quests" value="Add Your Quests&#10;&#10;At least one quest; priority and optional deadline" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8dde6;fontColor=#17202a;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="510" y="1250" width="260" height="110" as="geometry" /></mxCell><mxCell id="reveal" value="Player reveal&#10;&#10;Enter FocusUp; mark setup complete" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8dde6;fontColor=#17202a;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="950" y="1250" width="260" height="110" as="geometry" /></mxCell><mxCell id="permission" value="If Screen Time is denied&#10;&#10;Continue without a group. Enable permission later in iOS Settings before blocking apps." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f2f4f7;strokeColor=#d8dde6;fontColor=#505866;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="1450" width="1140" height="90" as="geometry" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#2457a6;fontColor=#2457a6;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="launch" target="signed"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endAr